---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import '../../../styles/global.css';

export async function getStaticPaths() {
  const proyectos = await getCollection('rehabilitacion');
  return proyectos.map(proyecto => ({
    params: { id: proyecto.id },
    props: { proyecto },
  }));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
---

<Layout>
  <Navbar />
  
  <main class="container mx-auto px-4 pt-32 pb-24 max-w-5xl">
    <article class="max-w-4xl mx-auto">
      {proyecto.data.image && (
        <div class="mb-12 rounded-2xl overflow-hidden border border-white/5 aspect-video bg-zinc-800">
          <Image 
            src={proyecto.data.image} 
            alt={proyecto.data.title} 
            class="w-full h-full object-cover"
          />
        </div>
      )}
      <header class="mb-12 border-b border-white/10 pb-12">
        <h1 class="text-4xl md:text-5xl font-black mb-6 text-white leading-tight">{proyecto.data.title}</h1>
        <p class="text-xl text-gray-400 italic font-light">{proyecto.data.description}</p>
        <div class="text-sm font-bold tracking-widest text-amber-500 uppercase mt-6">
          Fecha de ejecución: {proyecto.data.date.toLocaleDateString('es-ES', { month: 'long', year: 'numeric' })}
        </div>
      </header>
      
      <div class="prose prose-invert prose-amber max-w-none prose-headings:font-bold prose-img:rounded-xl">
        <Content />
      </div>
      
      <div class="mt-16 pt-8 border-t border-white/10 text-center md:text-left">
        <a href="/proyectos" class="inline-flex items-center px-8 py-4 bg-zinc-800 text-white font-bold rounded-full hover:bg-zinc-700 transition-all hover:scale-105 border border-white/5">
          <i class="fa-solid fa-arrow-left mr-3 text-amber-500"></i> Volver a Proyectos
        </a>
      </div>
    </article>
  </main>
  
  <Footer />
</Layout>
