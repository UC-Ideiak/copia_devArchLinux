---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import '../../styles/global.css';

// Obtenemos todos los proyectos de ambas colecciones
const proyectosImpermeabilizacion = await getCollection('impermeabilizacion');
const proyectosRehabilitacion = await getCollection('rehabilitacion');
---

<Layout>
  <Navbar />
  
  <main class="container mx-auto px-4 pt-32 pb-24">
    <h1 class="text-4xl md:text-5xl font-bold mb-12 text-center text-white">Nuestros Proyectos</h1>
    
    <section class="mb-16 overflow-hidden">
      <h2 class="text-2xl md:text-3xl font-semibold mb-8 text-amber-500 border-b border-white/10 pb-4">Impermeabilización</h2>
      <div class="carousel-container">
        <div class="carousel-track flex gap-8">
          {proyectosImpermeabilizacion.map(proyecto => (
            <article class="carousel-item min-w-[350px] max-w-[350px] bg-zinc-900/50 rounded-xl border border-white/5 overflow-hidden hover:border-amber-500/30 transition-all duration-500 flex flex-col group flex-shrink-0">
              {proyecto.data.image && (
                <div class="aspect-video overflow-hidden">
                  <Image 
                    src={proyecto.data.image} 
                    alt={proyecto.data.title} 
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  />
                </div>
              )}
              <div class="p-6 flex flex-col flex-grow">
                <h3 class="text-xl font-bold mb-3 text-white">{proyecto.data.title}</h3>
                <p class="text-gray-400 mb-6 flex-grow">{proyecto.data.description}</p>
                <a href={`/proyectos/impermeabilizacion/${proyecto.id}`} class="text-amber-500 hover:text-amber-400 font-semibold inline-flex items-center mt-auto group/link">
                  Ver detalles <span class="ml-2 transform group-hover/link:translate-x-1 transition-transform">→</span>
                </a>
              </div>
            </article>
          ))}
          {proyectosImpermeabilizacion.map(proyecto => (
            <article class="carousel-item min-w-[350px] max-w-[350px] bg-zinc-900/50 rounded-xl border border-white/5 overflow-hidden hover:border-amber-500/30 transition-all duration-500 flex flex-col group flex-shrink-0">
              {proyecto.data.image && (
                <div class="aspect-video overflow-hidden">
                  <Image 
                    src={proyecto.data.image} 
                    alt={proyecto.data.title} 
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  />
                </div>
              )}
              <div class="p-6 flex flex-col flex-grow">
                <h3 class="text-xl font-bold mb-3 text-white">{proyecto.data.title}</h3>
                <p class="text-gray-400 mb-6 flex-grow">{proyecto.data.description}</p>
                <a href={`/proyectos/impermeabilizacion/${proyecto.id}`} class="text-amber-500 hover:text-amber-400 font-semibold inline-flex items-center mt-auto group/link">
                  Ver detalles <span class="ml-2 transform group-hover/link:translate-x-1 transition-transform">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="overflow-hidden">
      <h2 class="text-2xl md:text-3xl font-semibold mb-8 text-amber-500 border-b border-white/10 pb-4">Rehabilitación</h2>
      <div class="carousel-container">
        <div class="carousel-track flex gap-8 reverse">
          {proyectosRehabilitacion.map(proyecto => (
            <article class="carousel-item min-w-[350px] max-w-[350px] bg-zinc-900/50 rounded-xl border border-white/5 overflow-hidden hover:border-amber-500/30 transition-all duration-500 flex flex-col group flex-shrink-0">
              {proyecto.data.image && (
                <div class="aspect-video overflow-hidden">
                  <Image 
                    src={proyecto.data.image} 
                    alt={proyecto.data.title} 
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  />
                </div>
              )}
              <div class="p-6 flex flex-col flex-grow">
                <h3 class="text-xl font-bold mb-3 text-white">{proyecto.data.title}</h3>
                <p class="text-gray-400 mb-6 flex-grow">{proyecto.data.description}</p>
                <a href={`/proyectos/rehabilitacion/${proyecto.id}`} class="text-amber-500 hover:text-amber-400 font-semibold inline-flex items-center mt-auto group/link">
                  Ver detalles <span class="ml-2 transform group-hover/link:translate-x-1 transition-transform">→</span>
                </a>
              </div>
            </article>
          ))}
          {proyectosRehabilitacion.map(proyecto => (
            <article class="carousel-item min-w-[350px] max-w-[350px] bg-zinc-900/50 rounded-xl border border-white/5 overflow-hidden hover:border-amber-500/30 transition-all duration-500 flex flex-col group flex-shrink-0">
              {proyecto.data.image && (
                <div class="aspect-video overflow-hidden">
                  <Image 
                    src={proyecto.data.image} 
                    alt={proyecto.data.title} 
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  />
                </div>
              )}
              <div class="p-6 flex flex-col flex-grow">
                <h3 class="text-xl font-bold mb-3 text-white">{proyecto.data.title}</h3>
                <p class="text-gray-400 mb-6 flex-grow">{proyecto.data.description}</p>
                <a href={`/proyectos/rehabilitacion/${proyecto.id}`} class="text-amber-500 hover:text-amber-400 font-semibold inline-flex items-center mt-auto group/link">
                  Ver detalles <span class="ml-2 transform group-hover/link:translate-x-1 transition-transform">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<style>
  .carousel-container {
    overflow: hidden;
    position: relative;
  }
  
  .carousel-track {
    animation: scroll 40s linear infinite;
  }
  
  .carousel-track.reverse {
    animation: scroll-reverse 40s linear infinite;
  }
  
  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-50% - 16px));
    }
  }
  
  @keyframes scroll-reverse {
    0% {
      transform: translateX(calc(-50% - 16px));
    }
    100% {
      transform: translateX(0);
    }
  }
  
  .carousel-container:hover .carousel-track,
  .carousel-container:hover .carousel-track.reverse {
    animation-play-state: paused;
  }
</style>
