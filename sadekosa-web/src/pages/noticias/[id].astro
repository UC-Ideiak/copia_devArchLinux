---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias');
  return noticias.map(noticia => ({
    params: { id: noticia.id },
    props: { noticia },
  }));
}

const { noticia } = Astro.props;
const { Content } = await render(noticia);
---

<Layout>
  <Navbar />
  
  <main class="container mx-auto px-4 pt-32 pb-24 max-w-4xl">
    <article class="bg-zinc-900/50 rounded-2xl border border-white/5 overflow-hidden">
      {noticia.data.image && (
        <div class="w-full h-64 md:h-96 relative bg-zinc-800">
          <Image 
            src={noticia.data.image} 
            alt={noticia.data.title} 
            class="w-full h-full object-cover"
          />
        </div>
      )}
      
      <div class="p-8 md:p-12">
        <header class="mb-12 border-b border-white/10 pb-12 text-center">
          <time class="text-sm font-bold tracking-widest text-amber-500 uppercase mb-4 block">
            {noticia.data.date.toLocaleDateString('es-ES', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <h1 class="text-3xl md:text-5xl font-black mb-6 text-white leading-tight">
            {noticia.data.title}
          </h1>
          <p class="text-xl text-gray-400 italic font-light">
            {noticia.data.description}
          </p>
        </header>
        
        <div class="prose prose-invert prose-amber max-w-none prose-headings:font-bold prose-img:rounded-xl">
          <Content />
        </div>
        
        <footer class="mt-16 pt-8 border-t border-white/10 text-center">
          <a href="/noticias" class="inline-flex items-center px-8 py-4 bg-zinc-800 text-white font-bold rounded-full hover:bg-zinc-700 transition-all hover:scale-105 border border-white/5">
            <i class="fa-solid fa-arrow-left mr-3 text-amber-500"></i> Volver a Noticias
          </a>
        </footer>
      </div>
    </article>
  </main>
  
  <Footer />
</Layout>
