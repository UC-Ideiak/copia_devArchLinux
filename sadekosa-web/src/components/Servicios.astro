---
/**
 * Sección de servicios con grid de 3 columnas.
 * Cada tarjeta incluye icono, título, descripción y enlace.
 */
---

<section id="servicios" class="py-24 px-6 md:px-12 bg-zinc-950">
	<div class="reveal">
		<h2 class="text-4xl md:text-6xl font-black mb-16 tracking-tighter">SOLUCIONES<br /><span class="text-amber-500">VERTICALES.</span></h2>

		<div class="grid md:grid-cols-3 gap-px bg-white/10">
			<!-- Rehabilitación Integral -->
			<div class="bg-zinc-900 p-12 hover:bg-zinc-800 transition group cursor-pointer">
				<i class="fas fa-building-circle-check text-4xl mb-6 text-amber-500"></i>
				<h3 class="text-2xl font-bold mb-4">Rehabilitación Integral</h3>
				<p class="text-gray-400 mb-6">Restauración estructural y estética de edificios emblemáticos con estándares de eficiencia 2026.</p>
				<span class="text-amber-500 group-hover:ml-2 transition-all">Saber más <i class="fas fa-arrow-right ml-2"></i></span>
			</div>
			<!-- Impermeabilización -->
			<div class="bg-zinc-900 p-12 hover:bg-zinc-800 transition group cursor-pointer">
				<i class="fas fa-droplet-slash text-4xl mb-6 text-amber-500"></i>
				<h3 class="text-2xl font-bold mb-4">Impermeabilización</h3>
				<p class="text-gray-400 mb-6">Sistemas avanzados de estanqueidad para cubiertas industriales y residenciales.</p>
				<span class="text-amber-500 group-hover:ml-2 transition-all">Saber más <i class="fas fa-arrow-right ml-2"></i></span>
			</div>
			<!-- Mantenimiento Predictivo -->
			<div class="bg-zinc-900 p-12 hover:bg-zinc-800 transition group cursor-pointer">
				<i class="fas fa-shield-halved text-4xl mb-6 text-amber-500"></i>
				<h3 class="text-2xl font-bold mb-4">Mantenimiento Predictivo</h3>
				<p class="text-gray-400 mb-6">Uso de sensores e IA para predecir patologías antes de que ocurran.</p>
				<span class="text-amber-500 group-hover:ml-2 transition-all">Saber más <i class="fas fa-arrow-right ml-2"></i></span>
			</div>
		</div>
	</div>
</section>
