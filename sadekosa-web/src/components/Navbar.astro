---
/**
 * Componente de navegación principal con efecto glassmorphism.
 * Incluye logo, enlaces y menú móvil.
 */
---

<nav class="fixed w-full z-50 glass-nav py-4 px-6 md:px-12 flex justify-between items-center">
	<a href="/" class="flex items-center">
		<img 
			src="/src/assets/logo-sadekosa-clean.png" 
			alt="sadekosa" 
			class="w-auto max-w-none"
			style="height: 80px; min-height: 80px;"
		/>
	</a>

	<div class="hidden lg:flex gap-6 lg:gap-8 text-xs lg:text-sm font-bold uppercase tracking-widest items-center">
		<a href="/nosotros/" class="hover:text-amber-500 transition text-white">Nosotros</a>
		<a href="/que-hacemos/" class="hover:text-amber-500 transition text-white">Qué Hacemos</a>
		<a href="/servicios/" class="hover:text-amber-500 transition text-white">Servicios</a>
		<a href="/proyectos/" class="hover:text-amber-500 transition text-white">Proyectos</a>
		<a href="/garantias/" class="hover:text-amber-500 transition text-white">Garantías</a>
		<a href="/noticias/" class="hover:text-amber-500 transition text-white">Noticias</a>
		<a href="/contacto/" class="hover:text-amber-500 transition text-amber-500">Contacto</a>
	</div>

	<button class="lg:hidden text-2xl text-white" id="menuBtn" aria-label="Abrir menú de navegación">
		<i class="fas fa-bars"></i>
	</button>
</nav>
