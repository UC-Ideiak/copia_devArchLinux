---
/**
 * Sección hero a pantalla completa con imagen de fondo parallax,
 * título principal, subtítulo, CTAs y premios.
 */
---

<header class="h-screen flex items-center px-6 md:px-12 hero-gradient relative">
	<div class="max-w-4xl z-10">
		<div class="inline-block px-4 py-1 mb-6 border border-amber-500 text-amber-500 text-xs font-bold tracking-widest uppercase">
			Desde 1986 | Líder en impermeabilización
		</div>
		<h1 class="text-5xl md:text-8xl font-black leading-none mb-6">
			40 AÑOS DE <br /><span class="text-amber-500">EXCELENCIA</span> CONSTRUCTIVA.
		</h1>
		<p class="text-xl md:text-2xl text-gray-300 mb-8 max-w-2xl font-light leading-relaxed">
			Rehabilitación técnica de edificios impulsada por <span class="text-white font-semibold">Inteligencia Artificial</span> y rigor de ingeniería.
		</p>
		<div class="flex flex-col sm:flex-row gap-4">
			<a href="#proyectos" class="bg-amber-500 text-black px-10 py-5 font-bold uppercase tracking-tighter hover:bg-amber-400 transition text-center">
				Ver Proyectos de Autoridad
			</a>
			<a href="#innovacion" class="border border-white/20 backdrop-blur-sm px-10 py-5 font-bold uppercase tracking-tighter hover:bg-white/10 transition text-center">
				DIPass & IA
			</a>
		</div>
	</div>
	<div class="absolute bottom-12 left-12 flex gap-8 items-center text-xs text-gray-500">
		<span>PREMIO EKI ERAIKIN 2022</span>
		<span>PRESIDENCIA ASCOBI</span>
		<span>GAZTEK INNOVATION</span>
	</div>
</header>
