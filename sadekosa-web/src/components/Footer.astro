				<li class="text-amber-500 font-bold">946 36 20 10</li>
				<li>sadekosa@sadekosa.com</li>
			</ul>
		</div>
	</div>
	<div class="pt-12 border-t border-white/5 text-[10px] text-gray-600 uppercase tracking-widest flex flex-col md:flex-row justify-between gap-4">
		<span>© 2026 Sadekosa S.A. - Maestría Constructiva impulsada por IA</span>
		<span>Clasificación Estatal & CAPV | ASCOBI | CAF BIZKAIA</span>
	</div>
</footer>
