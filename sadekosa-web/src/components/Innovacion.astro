---
/**
 * Sección de innovación (DIPass e IA) con fondo dorado,
 * lista de tecnologías y panel de terminal simulado.
 */
---

<section id="innovacion" class="py-24 bg-amber-500 text-black">
	<div class="px-6 md:px-12 grid md:grid-cols-2 gap-16 items-center">
		<div class="reveal">
			<h2 class="text-5xl md:text-7xl font-black tracking-tighter mb-8 leading-none">CONSTRUIMOS <br />EL FUTURO <br />CON DATOS.</h2>
			<div class="space-y-6">
				<div class="flex gap-4">
					<div class="w-12 h-12 bg-black text-amber-500 rounded-full flex-shrink-0 flex items-center justify-center font-bold">01</div>
					<div>
						<h5 class="font-black uppercase text-xl">DIPass (Digital Building Passport)</h5>
						<p class="font-medium">Gestión integral del ciclo de vida del edificio mediante gemelos digitales.</p>
					</div>
				</div>
				<div class="flex gap-4">
					<div class="w-12 h-12 bg-black text-amber-500 rounded-full flex-shrink-0 flex items-center justify-center font-bold">02</div>
					<div>
						<h5 class="font-black uppercase text-xl">Predicción de Fallos con IA</h5>
						<p class="font-medium">Algoritmos desarrollados con Semantic Systems para monitorización estructural.</p>
					</div>
				</div>
			</div>
		</div>
		<div class="relative reveal">
			<div class="aspect-video bg-black rounded-lg shadow-2xl overflow-hidden flex items-center justify-center p-8 border-8 border-black/10">
				<!-- Representación visual de IA -->
				<div class="text-amber-500 font-mono space-y-2 opacity-80 text-xs">
					<div>[AI_LOG] ANALYZING FACADE_GRID...</div>
					<div>[SYSTEM] THERMAL_LEAK DETECTED IN QUAD_04</div>
					<div>[DIPass] UPDATING ASSET_STATUS: MAINTENANCE_REQUIRED</div>
					<div class="h-1 w-full bg-amber-500/20 rounded">
						<div class="h-full bg-amber-500 w-[78%] animate-pulse"></div>
					</div>
					<div class="mt-8 text-lg font-bold">MAESTRÍA DIGITAL</div>
				</div>
			</div>
			<div class="absolute -bottom-6 -left-6 bg-white p-6 text-black font-black uppercase text-sm shadow-xl">
				SADEKOSA R&D LAB
			</div>
		</div>
	</div>
</section>
